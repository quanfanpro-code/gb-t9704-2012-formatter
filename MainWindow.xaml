<ui:FluentWindow x:Class="GBT9704_2012排版工具.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="GB/T9704—2012排版工具" Height="620" Width="760"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        Icon="程序图标.ico"
        FontFamily="Microsoft YaHei">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="GB/T9704—2012排版工具">
            <ui:TitleBar.Resources>
                <Style TargetType="ui:TitleBarButton" BasedOn="{StaticResource {x:Type ui:TitleBarButton}}">
                    <Style.Triggers>
                        <Trigger Property="ButtonType" Value="Minimize">
                            <Setter Property="Background" Value="#1A73E8" />
                            <Setter Property="ButtonsForeground" Value="White" />
                            <Setter Property="MouseOverBackground" Value="#1557B0" />
                            <Setter Property="MouseOverButtonsForeground" Value="White" />
                        </Trigger>
                        <Trigger Property="ButtonType" Value="Maximize">
                            <Setter Property="Background" Value="#107C10" />
                            <Setter Property="ButtonsForeground" Value="White" />
                            <Setter Property="MouseOverBackground" Value="#0B5A0B" />
                            <Setter Property="MouseOverButtonsForeground" Value="White" />
                        </Trigger>
                        <Trigger Property="ButtonType" Value="Restore">
                            <Setter Property="Background" Value="#107C10" />
                            <Setter Property="ButtonsForeground" Value="White" />
                            <Setter Property="MouseOverBackground" Value="#0B5A0B" />
                            <Setter Property="MouseOverButtonsForeground" Value="White" />
                        </Trigger>
                        <Trigger Property="ButtonType" Value="Close">
                            <Setter Property="Background" Value="#E81123" />
                            <Setter Property="ButtonsForeground" Value="White" />
                            <Setter Property="MouseOverBackground" Value="#F1707A" />
                            <Setter Property="MouseOverButtonsForeground" Value="White" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ui:TitleBar.Resources>
        </ui:TitleBar>
        <Grid Grid.Row="1" Margin="24,0,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="8" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="文件与处理设置" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBox x:Name="_selectedPathBox" IsReadOnly="True" Margin="0,0,0,10" Height="36"
                             VerticalContentAlignment="Center" Padding="8,0"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0" Content="浏览文件" Height="36" Margin="0,0,8,0" Padding="16,0"
                                   Click="BrowseFile_Click" Appearance="Success"/>
                        <ui:Button Grid.Column="1" Content="浏览文件夹" Height="36" Margin="0,0,16,0" Padding="16,0"
                                   Click="BrowseFolder_Click" Appearance="Success"/>
                        <CheckBox x:Name="_includeSubfoldersCheck" Grid.Column="2"
                                  Content="包含子文件夹" FontSize="12" VerticalAlignment="Center" Margin="0,2,0,0"/>
                        
                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Label Content="文种模式：" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox x:Name="_documentKindComboBox" Height="36" Width="140" SelectedIndex="0">
                                <ComboBoxItem Content="自动识别"/>
                                <ComboBoxItem Content="普通公文"/>
                                <ComboBoxItem Content="信函"/>
                                <ComboBoxItem Content="命令"/>
                                <ComboBoxItem Content="纪要"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="8" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="输出位置" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBox x:Name="_outputDirectoryBox" IsReadOnly="True" Margin="0,0,0,10" Height="36"
                             VerticalContentAlignment="Center" Padding="8,0"/>
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Content="选择输出目录" Height="36" Margin="0,0,8,0" Padding="16,0"
                                   Click="BrowseOutputFolder_Click" Appearance="Success"/>
                        <ui:Button Content="清空" Height="36" Margin="0,0,12,0" Padding="16,0"
                                   Click="ClearOutputFolder_Click" Appearance="Transparent"/>
                        <TextBlock Text="（留空则默认输出到原文件所在目录）" FontSize="12" Opacity="0.75" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ui:Button x:Name="_startButton" Appearance="Primary"
                           Width="140" Height="40" FontSize="14" FontWeight="SemiBold"
                           Click="Start_Click"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Grid>
                        <TextBlock x:Name="_statusText" Text="就绪" FontSize="12"/>
                        <TextBlock x:Name="_progressLabel" Text="" FontSize="12"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                    <ProgressBar x:Name="_progressBar" Minimum="0" Maximum="100" Value="0"
                                 Height="4" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
            <Border Grid.Row="3" Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="处理日志" FontSize="14" FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <RichTextBox x:Name="_logBox" Grid.Row="1" IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 FontSize="12"
                                 BorderThickness="0" Background="#1E1E1E"
                                 Foreground="#CCCCCC">
                        <RichTextBox.Resources>
                            <Style TargetType="{x:Type Paragraph}">
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="LineHeight" Value="18"/>
                            </Style>
                        </RichTextBox.Resources>
                        <FlowDocument PagePadding="8"
                                      FontFamily="Microsoft YaHei" FontSize="12"/>
                    </RichTextBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
